# ── Core ─────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://kraud.example.com           # public URL (emails, Monnify redirect, webhook)
KRAUD_SECRET=                               # REQUIRED in prod, 24+ random chars: openssl rand -hex 32
KRAUD_ADMINS=admin,ceo@kraud.ng             # comma-separated usernames/emails — admins are env-only
KRAUD_DATA_DIR=/data                        # persistent volume: uploads, receipts PDFs, seed files

# ── Database (Postgres) ──────────────────────────────
DATABASE_URL=postgresql://kraud:change-me@db:5432/kraud
POSTGRES_PASSWORD=change-me                 # used by docker-compose's db service

# ── Email (SMTP is required in production) ───────────
# Only when SMTP_HOST is empty AND NODE_ENV!=production are mails logged + "Dev" links shown.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                           # true for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kraud <no-reply@kraud.ng>"

# ── Payments (Monnify API — direct, or routed through Bannk) ──
# PAYMENT_PROVIDER=monnify  → talks to Monnify (MONNIFY_ENV picks sandbox/live; MONNIFY_BASE_URL optional override)
# PAYMENT_PROVIDER=bannk    → Bannk Dev Mode is Monnify-compatible (same field names, like an "OpenAI-compatible" API):
#                             MONNIFY_BASE_URL = your Bannk public URL (required), and the three MONNIFY_* keys below
#                             are the values from Bannk → Dev Mode → API keys. All payments then route through Bannk.
PAYMENT_PROVIDER=bannk                      # bannk | monnify
MONNIFY_ENV=sandbox                         # sandbox | live (ignored when PAYMENT_PROVIDER=bannk)
MONNIFY_BASE_URL=https://YOUR-BANNK-PUBLIC-URL   # Bannk public URL when bannk; blank = Monnify default
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=                         # also used to verify webhook HMAC-SHA512 signatures
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT=                     # optional: enables automatic disbursement for withdrawals
# Webhook URL to set in the Monnify dashboard / Bannk Dev Mode: ${APP_URL}/api/webhooks/monnify

# ── KYC (one-off NIN/BVN) ────────────────────────────
KYC_PROVIDER=manual                         # manual (admin queue) | monnify (VAS lookup) | sandbox (dev auto-approve)

# ── VerifyMe NIN test harness (/ver1) — Runtime only, never public ──
