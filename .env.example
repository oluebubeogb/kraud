# Primary admins — comma separated usernames or emails. Never hardcoded in source.
KRAUD_ADMINS=admin,ceo@kraud.ng
# Persistent data dir (DB + uploads + seed output). Mount a volume here in Coolify.
KRAUD_DATA_DIR=./data
# Session signing secret (any long random string)
KRAUD_SECRET=change-me-to-a-long-random-string
# Public base URL used in emails
APP_URL=http://localhost:3000
# SMTP — if SMTP_HOST is empty, mails are logged to the console and a "Dev: open link" button is shown
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kraud <no-reply@kraud.ng>"
# Monnify (demo is simulated; wire real keys in production)
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
